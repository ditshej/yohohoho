parameters:
	ignoreErrors:
		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: app/Http/Controllers/CardsController.php

		-
			message: '#^Binary operation "\." between ''%%"'' and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: app/Http/Controllers/CardsController.php

		-
			message: '#^Binary operation "\." between ''%%'' and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: app/Http/Controllers/CardsController.php

		-
			message: '#^Method App\\Http\\Controllers\\CardsImportController\:\:resolveColorFilter\(\) should return array\<int, App\\Enums\\CardColor\>\|null but returns array\<App\\Enums\\CardColor\>\.$#'
			identifier: return.type
			count: 1
			path: app/Http/Controllers/CardsImportController.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(mixed\)\: mixed\)\|null, Closure\(string\)\: App\\Enums\\CardColor given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/CardsImportController.php

		-
			message: '#^Parameter \#1 \$json of function json_decode expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/CardsImportController.php

		-
			message: '#^Parameter \#1 \$url of method Illuminate\\Http\\Client\\PendingRequest\<false\>\:\:get\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/CardsImportController.php

		-
			message: '#^Parameter \#2 \$array of function array_map expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/CardsImportController.php

		-
			message: '#^Part \$summary\[''imported''\] \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 2
			path: app/Http/Controllers/CardsImportController.php

		-
			message: '#^Part \$summary\[''skipped''\] \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 2
			path: app/Http/Controllers/CardsImportController.php

		-
			message: '#^Method App\\Http\\Requests\\ImportCardsFromApiRequest\:\:rules\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Http/Requests/ImportCardsFromApiRequest.php

		-
			message: '#^Method App\\Http\\Requests\\ImportCardsRequest\:\:rules\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Http/Requests/ImportCardsRequest.php

		-
			message: '#^Class App\\Models\\Card uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/Card.php

		-
			message: '#^Method App\\Models\\Card\:\:effects\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\HasMany does not specify its types\: TRelatedModel, TDeclaringModel$#'
			identifier: missingType.generics
